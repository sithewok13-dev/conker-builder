+// iOS: an app may not submit GPU work while it's in the background. Metal fails the command
+// buffer ("Insufficient Permission (to submit GPU work from background)") and the app was then
+// killed. The app pauses submissions as it leaves the foreground and resumes them when it's back
+// (plume_metal_set_gpu_paused); until then they wait where they start.
+static std::atomic<bool> plumeMetalGPUPaused{ false };
+
+extern "C" void plume_metal_set_gpu_paused(bool paused) {
+    plumeMetalGPUPaused.store(paused);
+}
+
+static void plumeMetalWaitWhileGPUPaused() {
+    while (plumeMetalGPUPaused.load()) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+}
